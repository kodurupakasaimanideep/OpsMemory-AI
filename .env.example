# Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
DATABASE_URL=sqlite:///./opsmind.db

# LLM Configuration (Groq Accelerated)
LLM_PROVIDER=groq # groq | mock | openai | gemini
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Hindsight Configuration
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=default-dev-key
HINDSIGHT_NAMESPACE=opsmind-production
MEMORY_CONFIDENCE_THRESHOLD=0.75

# Frontend Configuration
VITE_API_URL=/api

